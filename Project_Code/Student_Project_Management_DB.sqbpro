<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="Student_Project_Management_DB.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1812"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Faculty" custom_title="0" dock_id="4" table="4,7:mainFaculty"/><table title="Faculty" custom_title="0" dock_id="3" table="4,7:mainFaculty"/><table title="Students" custom_title="0" dock_id="5" table="4,8:mainStudents"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings><table schema="main" name="Faculty" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="64"/><column index="2" value="69"/><column index="3" value="66"/><column index="4" value="39"/><column index="5" value="73"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Students" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="68"/><column index="2" value="117"/><column index="3" value="29"/><column index="4" value="54"/><column index="5" value="93"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- This script creates the four tables for the student project management database.
-- It's optimized for SQLite and includes primary and foreign key constraints.

-- --------------------------------------------------------
-- Table 1: Students
-- Stores information about individual students.
-- student_id is the primary key.
-- --------------------------------------------------------
CREATE TABLE Students (
    student_id INTEGER PRIMARY KEY,
    first_name TEXT NOT NULL,
    last_name TEXT NOT NULL,
    email TEXT NOT NULL UNIQUE,
    major TEXT NOT NULL,
    enrollment_date TEXT NOT NULL
);

-- --------------------------------------------------------
-- Table 2: Faculty
-- Stores information about faculty members who supervise projects.
-- faculty_id is the primary key.
-- --------------------------------------------------------
CREATE TABLE Faculty (
    faculty_id INTEGER PRIMARY KEY,
    first_name TEXT NOT NULL,
    last_name TEXT NOT NULL,
    email TEXT NOT NULL UNIQUE,
    department TEXT NOT NULL
);

-- --------------------------------------------------------
-- Table 3: Projects
-- Stores information about different student projects.
-- project_id is the primary key.
-- It includes a foreign key to the Faculty table.
-- --------------------------------------------------------
CREATE TABLE Projects (
    project_id INTEGER PRIMARY KEY,
    project_name TEXT NOT NULL,
    description TEXT,
    start_date TEXT NOT NULL,
    end_date TEXT,
    status TEXT NOT NULL,
    faculty_id INTEGER,
    FOREIGN KEY (faculty_id) REFERENCES Faculty (faculty_id)
);

-- --------------------------------------------------------
-- Table 4: Project_Members
-- This is a junction table that links students to projects.
-- It defines a many-to-many relationship between Students and Projects.
-- It includes foreign keys to both the Students and Projects tables.
-- --------------------------------------------------------
CREATE TABLE Project_Members (
    member_id INTEGER PRIMARY KEY,
    project_id INTEGER NOT NULL,
    student_id INTEGER NOT NULL,
    role TEXT NOT NULL,
    join_date TEXT NOT NULL,
    FOREIGN KEY (project_id) REFERENCES Projects (project_id),
    FOREIGN KEY (student_id) REFERENCES Students (student_id)
);
